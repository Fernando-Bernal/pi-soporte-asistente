# Copia este archivo como .env y completa tus claves reales.
# .env NUNCA se sube a git (ya está en .gitignore).

# Proveedor primario de LLM: "gemini" u "openai"
LLM_PROVIDER=gemini

# API key de Google Gemini (proveedor primario)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# API key de OpenAI (usada como fallback si Gemini falla, y requerida por la consigna)
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# Modelos usados por cada proveedor (verificá disponibilidad en tu cuenta antes de correr)
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
